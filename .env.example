# Travel MCP Server Configuration

# Server Configuration
TRAVEL_SERVER_NAME=travel-mcp-server
TRAVEL_VERSION=1.0.0
TRAVEL_HOST=0.0.0.0
TRAVEL_PORT=8000

# MCP Configuration
TRAVEL_MCP_HOST=0.0.0.0
TRAVEL_MCP_PORT=8000

# Performance Configuration
TRAVEL_MAX_CONCURRENT_REQUESTS=100
TRAVEL_REQUEST_TIMEOUT=30.0

# Data Source Configuration
# Set to true to use mock data, false to use real APIs
TRAVEL_USE_MOCK_DATA=true

# Real API Keys (used when USE_MOCK_DATA=false)
TRAVEL_AMAP_API_KEY=your_amap_api_key_here
TRAVEL_WEATHER_API_KEY=your_weather_api_key_here

# Security Configuration
TRAVEL_API_KEY=your_api_key_here
TRAVEL_RATE_LIMIT_PER_MINUTE=60

# Monitoring Configuration
TRAVEL_LOG_LEVEL=INFO
TRAVEL_METRICS_ENABLED=true
